ced"}]},{"id":"M6-S2","title":"GridSearchCV with Hyperparameter Tuning","description":"This sub-module covers how to use GridSearchCV to find the best model for a dataset by tuning hyperparameters such as learning rate and regularization strength.","activities":[{"id":"M6-S2-A1","title":"Code Completion Exercise 23.0","description":"Write a Python program that uses GridSearchCV to find the best model for a dataset by tuning hyperparameters.","duration":"120","difficulty_level":"advanced"},{"id":"M6-S2-A2","title":"Code Completion Exercise 24.0","description":"Write a Python program that calculates the grid search space for a model using GridSearchCV.","duration":"120","difficulty_level":"advanced"}]}]},{"id":"M7","title":"Advanced Model Selection with Bayesian Optimization","description":"This module introduces how to use Bayesian optimization to perform model selection for complex datasets.","sub_modules":[{"id":"M7-S1","title":"Bayesian Optimization with Scipy","description":"This sub-module covers how to use the scipy library to perform Bayesian optimization for a model on a dataset.","activities":[{"id":"M7-S1-A1","title":"Code Completion Exercise 25.0","description":"Write a Python program that uses Bayesian optimization to find the best hyperparameters for a model.","duration":"120","difficulty_level":"advanced"},{"id":"M7-S1-A2","title":"Code Completion Exercise 26.0","description":"Write a Python program that calculates the expected objective value for a Bayesian optimization problem.","duration":"120","difficulty_level":"advanced"}]},{"id":"M7-S2","title":"Bayesian Optimization with Hyperopt","description":"This sub-module covers how to use the hyperopt library to perform Bayesian optimization for a model on a dataset.","activities":[{"id":"M7-S2-A1","title":"Code Completion Exercise 27.0","description":"Write a Python program that uses Bayesian optimization with hyperopt to find the best hyperparameters for a model.","duration":"120","difficulty_level":"ad