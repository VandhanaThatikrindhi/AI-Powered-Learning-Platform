[2025-02-13T13:33:44.0724694]   {"learning_path":{"modules":[{"id":"M1","title":"Introduction to Storytelling in Marketing","description":"This module introduces the concept of storytelling in marketing, its importance, and how it can be applied in real-world scenarios.","sub_modules":[{"id":"M1-S1","title":"What is Storytelling in Marketing?","description":"This sub-module explains the concept of storytelling in marketing, its history, and how it differs from other forms of communication.","activities":[{"id":"M1-S1-A1","title":"Define Storytelling in Marketing","description":"Identify and define storytelling in marketing. Provide examples of successful storytelling campaigns.","duration":30,"quiz":{"type":"multiple_choice","correct_answers":["The use of narrative techniques to engage audiences and convey messages."],"questions":["What is the primary purpose of storytelling in marketing?","How does storytelling differ from other forms of communication?"]}},{"id":"M1-S1-A2","title":"History of Storytelling in Marketing","description":"Explain the history and evolution of storytelling in marketing. Discuss its impact on various industries.","duration":45,"quiz":{"type":"short_answer","correct_answers":["The early days of advertising, the rise of digital media, and the current state of the industry."],"questions":["When did storytelling first emerge as a marketing strategy?"]}}],"learning_outcomes":["Understanding of the concept of storytelling in marketing.","Knowledge of the history and evolution of storytelling in marketing."]},{"id":"M1-S2","title":"Types of Storytelling in Marketing","description":"This sub-module explores different types of storytelling in marketing, including brand storytelling, customer storytelling, and experiential storytelling.","activities":[{"id":"M1-S2-A1","title":"Brand Storytelling","description":"Explain the concept of brand storytelling and its application in marketing. Provide examples of successful brand storytelling campaigns.","d