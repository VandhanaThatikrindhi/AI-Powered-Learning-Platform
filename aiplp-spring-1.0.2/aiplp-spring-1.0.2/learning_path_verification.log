[2025-04-14T10:17:07.971812731]   {"learning_path":{"modules":[{"id":"M1","title":"Introduction to Machine Learning for Hobbyists","description":"This module introduces the basics of machine learning and its applications.","sub_modules":[{"id":"M1-S1","title":"What is Machine Learning?","description":"Learn about the history, types, and applications of machine learning.","activities":[{"id":"M1-S1-A1","title":"Machine Learning History","description":"Explore the evolution of machine learning from its early beginnings to current advancements.","duration":"One Hour"},{"id":"M1-S1-A2","title":"Types of Machine Learning","description":"Discover the different types of machine learning: supervised, unsupervised, and reinforcement learning.","duration":"Two Hours"}],"learning_outcomes":["Define the history and evolution of machine learning."]},{"id":"M1-S2","title":"Machine Learning Applications","description":"Learn about real-world applications of machine learning in various fields.","activities":[{"id":"M1-S2-A1","title":"Applications of Machine Learning in Healthcare","description":"Explore the use of machine learning in medical diagnosis, patient outcomes prediction, and personalized medicine.","duration":"Two Hours"},{"id":"M1-S2-A2","title":"Machine Learning in E-commerce","description":"Discover how machine learning is used in recommendation systems and fraud detection.","duration":"One Hour"}],"learning_outcomes":["List at least three real-world applications of machine learning."]}],"duration":"Eight Hours"},{"id":"M2","title":"Supervised Learning","description":"Dive deeper into supervised learning techniques and algorithms.","sub_modules":[{"id":"M2-S1","title":"Regression Analysis","description":"Learn about linear regression, decision trees, and random forests for regression problems.","activities":[{"id":"M2-S1-A1","title":"Linear Regression Example","description":"Understand the concept of linear regression with a practical example.","duration":"Two Hours"},{"id":"M2-S1-A2","title":"Decision Trees and Random Forests","description":"Explore the difference between decision trees, random forests, and their applications.","duration":"Three Hours"}],"learning_outcomes":["Define linear regression, decision trees, and random forests."]},{"id":"M2-S2","title":"Classification Analysis","description":"Study the concepts of logistic regression, support vector machines (SVMs), and neural networks for classification problems.","activities":[{"id":"M2-S2-A1","title":"Logistic Regression Example","description":"Understand the concept of logistic regression with a practical example.","duration":"Two Hours"},{"id":"M2-S2-A2","title":"Support Vector Machines (SVM) and Neural Networks","description":"Explore the difference between SVMs, neural networks, and their applications.","duration":"Three Hours"}],"learning_outcomes":["Define logistic regression, support vector machines (SVM), and neural networks."]}],"duration":"Nine Hours"},{"id":"M3","title":"Unsupervised Learning","description":"Dive deeper into unsupervised learning techniques and algorithms.","sub_modules":[{"id":"M3-S1","title":"Clustering Algorithms","description":"Learn about k-means clustering, hierarchical clustering, and DBSCAN for clustering problems.","activities":[{"id":"M3-S1-A1","title":"K-Means Clustering Example","description":"Understand the concept of k-means clustering with a practical example.","duration":"Two Hours"},{"id":"M3-S1-A2","title":"Hierarchical Clustering Algorithm and DBSCAN","description":"Explore the difference between hierarchical clustering, DBSCAN, and their applications.","duration":"Three Hours"}],"learning_outcomes":["Define k-means clustering, hierarchical clustering, and DBSCAN."]},{"id":"M3-S2","title":"Dimensionality Reduction","description":"Study the techniques of dimensionality reduction: PCA, t-SNE, and feature selection.","activities":[{"id":"M3-S2-A1","title":"Principal Component Analysis (PCA) Example","description":"Understand the concept of PCA with a practical example.","duration":"Two Hours"},{"id":"M3-S2-A2","title":"t-SNE and Feature Selection","description":"Explore the difference between t-SNE, feature selection, and their applications.","duration":"Three Hours"}],"learning_outcomes":["Define PCA, t-SNE, and feature selection."]}],"duration":"Nine Hours"},{"id":"M4","title":"Reinforcement Learning","description":"Learn about the basics of reinforcement learning: Markov Decision Processes (MDPs), Q-Learning, and SARSA.","sub_modules":[{"id":"M4-S1","title":"Markov Decision Processes (MDPs)","description":"Understand the concept of MDPs with a practical example.","activities":[{"id":"M4-S1-A1","title":"MDP Example","description":"Learn about MDPs, states, actions, and rewards.","duration":"Two Hours"}],"learning_outcomes":["Define Markov Decision Processes (MDPs)."]},{"id":"M4-S2","title":"Q-Learning and SARSA","description":"Study the difference between Q-Learning, SARSA, and their applications.","activities":[{"id":"M4-S2-A1","title":"Q-Learning Example","description":"Understand the concept of Q-Learning with a practical example.","duration":"Two Hours"},{"id":"M4-S2-A2","title":"SARSA Explanation and Practice","description":"Learn about SARSA, its updates rules, and practice exercises.","duration":"Three Hours"}],"learning_outcomes":["Define Q-Learning, SARSA, and their applications."]}],"duration":"Six Hours"},{"id":"M5","title":"Problem-Solving in Machine Learning","description":"Practice solving machine learning problems with real-world datasets.","sub_modules":[{"id":"M5-S1","title":"Data Preprocessing and Normalization","description":"Learn about data preprocessing techniques: handling missing values, feature scaling, and normalization.","activities":[{"id":"M5-S1-A1","title":"Data Preprocessing Practice Problem 1","description":"Apply data preprocessing techniques to a real-world dataset.","duration":"Two Hours"},{"id":"M5-S1-A2","title":"Data Preprocessing Practice Problem 2","description":"Apply data preprocessing techniques to another real-world dataset.","duration":"Two Hours"}],"learning_outcomes":["Apply data preprocessing techniques."]},{"id":"M5-S2","title":"Model Evaluation and Validation","description":"Learn about model evaluation metrics: accuracy, precision, recall, F1-score, and AUC-ROC.","activities":[{"id":"M5-S2-A1","title":"Model Evaluation Practice Problem 1","description":"Evaluate the performance of a trained model using different metrics.","duration":"Two Hours"},{"id":"M5-S2-A2","title":"Model Evaluation Practice Problem 2","description":"Evaluate the performance of another trained model using different metrics.","duration":"Two Hours"}],"learning_outcomes":["Apply model evaluation metrics."]},{"id":"M5-S3","title":"Model Tuning and Optimization","description":"Learn about hyperparameter tuning techniques: grid search, random search, and Bayesian optimization.","activities":[{"id":"M5-S3-A1","title":"Model Tuning Practice Problem 1","description":"Tune the hyperparameters of a trained model using different techniques.","duration":"Two Hours"},{"id":"M5-S3-A2","title":"Model Tuning Practice Problem 2","description":"Tune the hyperparameters of another trained model using different techniques.","duration":"Two Hours"}],"learning_outcomes":["Apply hyperparameter tuning techniques."]}],"duration":"Eight Hours"},{"id":"M6","title":"Final Project: Machine Learning Application","description":"Develop a real-world machine learning application using the concepts learned throughout the course.","sub_modules":[{"id":"M6-S1","title":"Project Idea and Planning","description":"Choose a project idea, research the topic, and plan the project scope and timeline.","activities":[{"id":"M6-S1-A1","title":"Project Idea and Planning Practice Problem 1","description":"Plan the project scope and timeline for a real-world dataset.","duration":"Two Hours"},{"id":"M6-S1-A2","title":"Project Idea and Planning Practice Problem 2","description":"Plan the project scope and timeline for another real-world dataset.","duration":"Two Hours"}],"learning_outcomes":["Plan a machine learning project."]},{"id":"M6-S2","title":"Data Collection and Preprocessing","description":"Collect and preprocess the data for the chosen project.","activities":[{"id":"M6-S2-A1","title":"Data Collection and Preprocessing Practice Problem 1","description":"Collect and preprocess a real-world dataset.","duration":"Two Hours"},{"id":"M6-S2-A2","title":"Data Collection and Preprocessing Practice Problem 2","description":"Collect and preprocess another real-world dataset.","duration":"Two Hours"}],"learning_outcomes":["Apply data collection and preprocessing techniques."]},{"id":"M6-S3","title":"Model Implementation and Evaluation","description":"Implement the machine learning model using the chosen algorithm and evaluate its performance.","activities":[{"id":"M6-S3-A1","title":"Model Implementation and Evaluation Practice Problem 1","description":"Implement a machine learning model using a real-world dataset.","duration":"Two Hours"},{"id":"M6-S3-A2","title":"Model Implementation and Evaluation Practice Problem 2","description":"Implement another machine learning model using a real-world dataset.","duration":"Two Hours"}],"learning_outcomes":["Apply machine learning models."]},{"id":"M6-S4","title":"Final Report and Presentation","description":"Write a final report and create a presentation to showcase the project results.","activities":[{"id":"M6-S4-A1","title":"Final Report and Presentation Practice Problem 1","description":"Write a final report for a real-world dataset.","duration":"Two Hours"},{"id":"M6-S4-A2","title":"Final Report and Presentation Practice Problem 2","description":"Create a presentation to showcase the results of another real-world dataset.","duration":"Two Hours"}],"learning_outcomes":["Write a final report and create a presentation."]}],"duration":"Ten Hours"}]},"course_id":55,"user_id":1,"quiz_performance"