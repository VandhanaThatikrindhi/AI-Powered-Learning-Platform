_level":"advanced"},{"id":"M3-S2-A2","title":"Code Completion Exercise 12.0","description":"Write a Python program that calculates the confidence interval for a hypothesis test.","duration":"120","difficulty_level":"advanced"}]}]},{"id":"M4","title":"Data Visualization with Plotly","description":"This module introduces how to create interactive visualizations using the Plotly library in Python.","sub_modules":[{"id":"M4-S1","title":"Interactive Visualizations with Plotly","description":"This sub-module covers how to create basic interactive visualizations such as scatter plots, bar charts, and histograms using the Plotly library in Python.","activities":[{"id":"M4-S1-A1","title":"Code Completion Exercise 13.0","description":"Write a Python program that creates an interactive scatter plot of a dataset.","duration":"90","difficulty_level":"intermediate"},{"id":"M4-S1-A2","title":"Code Completion Exercise 14.0","description":"Write a Python program that creates an interactive bar chart of a dataset.","duration":"90","difficulty_level":"intermediate"}]},{"id":"M4-S2","title":"Advanced Interactive Visualizations with Plotly","description":"This sub-module covers how to create more advanced interactive visualizations such as treemaps and heatmaps using the Plotly library in Python.","activities":[{"id":"M4-S2-A1","title":"Code Completion Exercise 15.0","description":"Write a Python program that creates an interactive heatmap of a dataset.","duration":"120","difficulty_level":"advanced"},{"id":"M4-S2-A2","title":"Code Completion Exercise 16.0","description":"Write a Python program that creates an interactive treemap of a dataset.","duration":"120","difficulty_level":"advanced"}]}]},{"id":"M5","title":"Data Mining with Scikit-Learn","description":"This module introduces how to perform data mining tasks such as clustering, dimensionality reduction, and model selection using the Scikit-Learn library in Python.","sub_modules":[{"id":"M5-S1","title":"Clustering with K-Means","d